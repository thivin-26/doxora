# Copy this file to .env and fill in your values.

# Required for all AI features (summarize, chat, extract, generate).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here

# Optional overrides:
# Model ID to use for all AI calls. OpenRouter model names look like "openai/gpt-4.1-mini".
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=DocuMind

# Port the Flask app listens on.
PORT=5000

# Set to "false" to disable Flask debug mode in production.
FLASK_DEBUG=true

# --- Supabase auth ---------------------------------------------------------
# The React frontend sends a Supabase session token on every API request.
# Set this to your Supabase project's JWT Secret (Project Settings -> API ->
# JWT Settings -> JWT Secret) so the backend can verify who's calling.
# If left unset, auth is disabled and every request is treated as one shared
# local-dev user — handy for local development before Supabase is wired up.
SUPABASE_JWT_SECRET=

# Restrict CORS to your deployed frontend URL in production, e.g.
# https://documind.yourdomain.com. Defaults to "*" (any origin) for local dev.
FRONTEND_ORIGIN=*

# --- Supabase persistence (optional) ---------------------------------------
# If set, document metadata and chat history are mirrored into Postgres
# (see supabase/schema.sql) so they survive a server restart. Leave unset to
# keep everything in-memory only (fine for local development).
# SUPABASE_URL is the same project URL as the frontend's VITE_SUPABASE_URL.
# SUPABASE_SERVICE_ROLE_KEY is the *secret* service_role key (Project
# Settings -> API) — never expose this one to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
